# Wayfarer Environment Configuration
# Copy this file to .env to configure local settings:
# cp .env.example .env

# Server port (default: 5000)
PORT=5000

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Add your AI API key if you want to enable live cloud LLM itinerary generation.
# If omitted or left empty, Wayfarer's intelligent built-in generator creates full,
# realistic day-by-day itineraries with attractions, dining, and hotel recommendations offline.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
